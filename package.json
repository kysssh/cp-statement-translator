{
  "name": "cp-statement-translator",
  "private": true,
  "version": "1.1.0",
  "description": "Extensión de Chrome que traduce enunciados de Codeforces y CSES y documentación de USACO Guide y CP-Algorithms al español, preservando fórmulas y código.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "zip": "npm run build && node tools/package-extension.mjs",
    "check": "tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.33",
    "@types/chrome": "^0.3.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
